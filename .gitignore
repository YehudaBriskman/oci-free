# Never commit: contains the Tailscale auth key
terraform.tfvars
*.tfvars
!*.tfvars.example

.terraform/
*.tfstate
*.tfstate.*
crash.log
tfplan
*.tfplan

# Cloudflare API token
.cf-token

# GitHub OAuth app credentials
.github-oauth

# Forgejo API token
.forgejo-token

# CouchDB application user password
.couch-api-pw

# SMTP app password
.smtp-pw

# Traefik proof-of-transit value (also lives in the rendered middleware)
.admin-proxy-secret
k8s/admin-gate.rendered.yaml
