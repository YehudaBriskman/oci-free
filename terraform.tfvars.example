tenancy_ocid   = "ocid1.tenancy.oc1..REPLACE"
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Reusable key from https://login.tailscale.com/admin/settings/keys
tailscale_auth_key = "tskey-auth-REPLACE"

# Rescue path for public SSH. Set to null once Tailscale SSH is confirmed.
ssh_allowed_cidr = "203.0.113.4/32"
