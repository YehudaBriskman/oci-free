# Alertmanager config for kube-prometheus-stack. Not applied directly; the
# .tmpl suffix keeps `kubectl apply -f k8s/` away from it (see #23).
# telemetry-secrets.sh renders it into the Secret `alertmanager-config` that
# monitoring-values.yaml points at. The substitutions (host, port, user, sender
# and recipient) are not secret; they come from the site's own SMTP settings in
# prod/portfolio-api-env (Resend since 2026-11-16; Gmail rejected the old app
# password with 535). The SMTP password is never in here: it is read from a file
# mounted from the Secret `alertmanager-smtp`. Port 465 is implicit TLS, which
# Alertmanager handles itself when the smarthost port is 465.
#
# Only alerts labelled team=windom (#14) or team=portfolio (#54, the rules in
# portfolio-alerts.yaml) are emailed. Everything else, including the chart's
# stock cluster alerts, still goes to "null" as it did before #14. Both teams
# use the one `email` receiver, so there is a single address to maintain.
global:
  smtp_smarthost: __SMTP_HOST__:__SMTP_PORT__
  smtp_from: __SMTP_FROM__
  smtp_auth_username: __SMTP_USER__
  smtp_auth_password_file: /etc/alertmanager/secrets/alertmanager-smtp/password
  smtp_require_tls: true
  resolve_timeout: 5m

route:
  receiver: "null"
  group_by: [alertname]
  routes:
    # Watchdog always fires while Prometheus and Alertmanager work. It is
    # POSTed to the external heartbeat (healthchecks.io) every 2 minutes; the
    # outside service emails the owner when the pings stop. No data in the ping.
    - matchers: ['alertname = "Watchdog"']
      receiver: heartbeat
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 2m
    # Token reuse and pool exhaustion: send at once and remind hourly.
    - matchers: ['team = "windom"', 'severity = "page"']
      receiver: email
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1h
    - matchers: ['team = "windom"']
      receiver: email
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
    # Node, container, stack and uptime alerts (#54). Grouped by alertname and
    # namespace so ten pods of one problem are one email, not ten.
    - matchers: ['team = "portfolio"']
      receiver: email
      group_by: [alertname, namespace]
      routes:
        - matchers: ['severity = "critical"']
          receiver: email
          group_wait: 0s
          group_interval: 1m
          repeat_interval: 1h
        - matchers: ['severity = "warning"']
          receiver: email
          group_wait: 1m
          group_interval: 5m
          repeat_interval: 6h

inhibit_rules:
  # The critical mutes the same alert's warning for the same target.
  - source_matchers: ['team = "portfolio"', 'severity = "critical"']
    target_matchers: ['team = "portfolio"', 'severity = "warning"']
    equal: [alertname, namespace, instance, name, pod, container, mountpoint, persistentvolumeclaim, deployment, cronjob, service]
  # A node that is down explains every pod, probe, edge and backup alert.
  - source_matchers: ['team = "portfolio"', 'alertname = "NodeDown"']
    target_matchers: ['team = "portfolio"', 'alertname !~ "Node.*"']

receivers:
  - name: heartbeat
    webhook_configs:
      - url_file: /etc/alertmanager/secrets/alertmanager-heartbeat/url
        send_resolved: false
        max_alerts: 1
  - name: "null"
  - name: email
    email_configs:
      - to: __ALERT_TO__
        send_resolved: true
