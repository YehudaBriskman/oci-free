# Alertmanager config for kube-prometheus-stack. Not applied directly; the
# .tmpl suffix keeps `kubectl apply -f k8s/` away from it (see #23).
# telemetry-secrets.sh renders it into the Secret `alertmanager-config` that
# monitoring-values.yaml points at. The only substitution is the address.
# The Gmail app password is never in here: it is read from a file mounted from
# the Secret `alertmanager-smtp`.
#
# Only alerts labelled team=windom are emailed. Everything else, including the
# chart's stock cluster alerts, still goes to "null" as it did before #14.
global:
  smtp_smarthost: smtp.gmail.com:587
  smtp_from: __SMTP_USER__
  smtp_auth_username: __SMTP_USER__
  smtp_auth_password_file: /etc/alertmanager/secrets/alertmanager-smtp/password
  smtp_require_tls: true
  resolve_timeout: 5m

route:
  receiver: "null"
  group_by: [alertname]
  routes:
    - matchers: ['alertname = "Watchdog"']
      receiver: "null"
    # Token reuse and pool exhaustion: send at once and remind hourly.
    - matchers: ['team = "windom"', 'severity = "page"']
      receiver: email
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1h
    - matchers: ['team = "windom"']
      receiver: email
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h

receivers:
  - name: "null"
  - name: email
    email_configs:
      - to: __SMTP_USER__
        send_resolved: true
